<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sana Özel...</title>
  <style>
    body {
      margin: 0;
      height: 100vh;
      background: linear-gradient(135deg, #050508, #12081c, #1f0d2c);
      overflow: hidden;
      display: flex;
      justify-content: center;
      align-items: center;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      color: white;
    }

    /* Arka plan yıldızları */
    .star {
      position: absolute;
      background: white;
      border-radius: 50%;
      animation: twinkle 2s infinite ease-in-out;
    }

    @keyframes twinkle {
      0%, 100% { opacity: 0.2; transform: scale(0.8); }
      50% { opacity: 1; transform: scale(1.2); }
    }

    /* Romantik Karşılama Yazısı */
    .message {
      text-align: center;
      z-index: 100;
      position: absolute;
      padding: 35px 45px;
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(15px);
      border-radius: 20px;
      border: 1px solid rgba(255, 75, 75, 0.4);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.8);
      animation: fadeInMsg 2s ease-out forwards;
      max-width: 85%;
      transition: opacity 1.5s ease;
    }

    @keyframes fadeInMsg {
      0% { opacity: 0; transform: translateY(30px) scale(0.9); }
      100% { opacity: 1; transform: translateY(0) scale(1); }
    }

    .message h1 {
      font-size: clamp(1.2rem, 5vw, 1.8rem);
      margin-bottom: 15px;
      line-height: 1.4;
      background: linear-gradient(45deg, #ff416c, #ff4b2b);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      text-shadow: 0 0 20px rgba(255, 65, 108, 0.5);
    }

    .message p {
      font-size: 1.3rem;
      opacity: 0.95;
      letter-spacing: 1px;
      font-weight: bold;
      color: #ffb6c1;
    }

    /* Uçuşan Kalpler */
    .floating-heart {
      position: absolute;
      font-size: 28px;
      animation: flyUp 4s linear forwards;
      z-index: 50;
      user-select: none;
    }

    @keyframes flyUp {
      0% { transform: translateY(100vh) scale(0.4); opacity: 0; }
      30% { opacity: 1; }
      100% { transform: translateY(-20vh) scale(1.5); opacity: 0; }
    }

    /* Tek Fidenin Gelişim Alanı */
    .single-plant-container {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) scale(0.3);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      z-index: 10;
      opacity: 0;
      animation: showPlant 1s ease forwards;
      transition: opacity 1.5s ease, transform 1.5s ease;
    }

    @keyframes showPlant {
      to { opacity: 1; transform: translate(-50%, -50%) scale(1); }
    }

    .plant-stage {
      font-size: 90px;
      filter: drop-shadow(0 0 25px rgba(255, 0, 0, 0.85));
      user-select: none;
      transition: transform 0.4s ease;
    }

    /* Dev Güllerden Kalp ve Yapraklar */
    #bg-elements {
      position: absolute;
      top: 0; left: 0;
      width: 100vw; height: 100vh;
      pointer-events: none;
      z-index: 1;
    }

    .falling-petal {
      position: absolute;
      top: -10vh;
      opacity: 0.7;
      user-select: none;
      animation: fall linear infinite;
    }

    @keyframes fall {
      0% { transform: translateY(0vh) rotate(0deg) translateX(0px); opacity: 0; }
      10% { opacity: 0.8; }
      90% { opacity: 0.8; }
      100% { transform: translateY(110vh) rotate(360deg) translateX(80px); opacity: 0; }
    }

    #heart-wrapper {
      position: absolute;
      top: 50%;
      left: 50%;
      opacity: 0;
      transition: opacity 3s ease;
      z-index: 20;
      pointer-events: none;
    }

    #heart-container {
      position: relative;
      width: 0; 
      height: 0; 
      animation: heartbeat 1.4s infinite;
    }

    #heart-container::before {
      content: '';
      position: absolute;
      top: -200px; left: -200px;
      width: 400px; height: 400px;
      background: radial-gradient(circle, rgba(255, 10, 40, 0.3) 0%, transparent 60%);
      z-index: -1;
      filter: blur(30px);
    }

    .rose {
      position: absolute;
      font-size: 26px;
      user-select: none;
      filter: drop-shadow(3px 5px 4px rgba(0, 0, 0, 0.7));
    }

    @keyframes heartbeat {
      0% { transform: scale(1); }
      15% { transform: scale(1.06); }
      30% { transform: scale(1); }
      45% { transform: scale(1.03); }
      60% { transform: scale(1); }
      100% { transform: scale(1); }
    }
  </style>
</head>
<body>

  <!-- Arka Plan Elementleri -->
  <div id="bg-elements"></div>
  <div id="heart-wrapper">
    <div id="heart-container"></div>
  </div>

  <!-- Yıldızlar -->
  <script>
    for (let i = 0; i < 90; i++) {
      const star = document.createElement('div');
      star.className = 'star';
      star.style.width = Math.random() * 3 + 'px';
      star.style.height = star.style.width;
      star.style.left = Math.random() * window.innerWidth + 'px';
      star.style.top = Math.random() * window.innerHeight + 'px';
      star.style.animationDuration = (Math.random() * 2 + 1) + 's';
      document.body.appendChild(star);
    }
  </script>

  <!-- Romantik Yazı -->
  <div class="message" id="romanticMsg">
    <h1>Geriye dönüp baktığımda hayatımı bahara çevirdiğini görüyorum. Hayatıma kattığın tüm güzellikler için küçük bir teşekkür..🌹</h1>
    <p>SENİ ÇOK SEVİYORUMM. ❤️</p>
  </div>

  <script>
    function startHeartsShow() {
      let heartCount = 0;
      const heartInterval = setInterval(() => {
        if (heartCount > 35) {
          clearInterval(heartInterval);
          return;
        }
        const heart = document.createElement('div');
        heart.className = 'floating-heart';
        heart.innerHTML = '❤️';
        heart.style.left = Math.random() * window.innerWidth + 'px';
        heart.style.fontSize = (Math.random() * 25 + 20) + 'px';
        document.body.appendChild(heart);
        setTimeout(() => heart.remove(), 4000);
        heartCount++;
      }, 100);
    }

    function createGiantHeart() {
      // 1. Düşen Yapraklar
      const bgContainer = document.getElementById('bg-elements');
      for (let i = 0; i < 25; i++) {
        const petal = document.createElement('div');
        petal.className = 'falling-petal';
        petal.innerHTML = Math.random() > 0.4 ? '🌹' : '🥀';
        petal.style.left = (Math.random() * 100) + 'vw';
        petal.style.animationDuration = (Math.random() * 7 + 6) + 's';
        petal.style.animationDelay = (Math.random() * 5) + 's';
        petal.style.fontSize = (Math.random() * 12 + 12) + 'px';
        petal.style.filter = `blur(${Math.random() * 3}px) drop-shadow(0 5px 5px rgba(0,0,0,0.5))`;
        bgContainer.appendChild(petal);
      }

      // 2. Güllerden Kalp Çizimi (Matematiksel hatalar düzeltildi)
      const heartContainer = document.getElementById('heart-container');
      const scaleFactor = Math.min(window.innerWidth / 40, 16); 

      for (let i = 0; i < 500; i++) {
        const t = Math.random() * Math.PI * 2;
        const r = Math.sqrt(Math.random()) * scaleFactor;

        // Kalp Parametrik Denklemi
        const x = r * (16 * Math.pow(Math.sin(t), 3));
        const y = -r * (13 * Math.cos(t) - 5 * Math.cos(2 * t) - 2 * Math.cos(3 * t) - Math.cos(4 * t));

        const rose = document.createElement('div');
        rose.className = 'rose';
        rose.innerHTML = '🌹';
        rose.style.left = `${x}px`;
        rose.style.top = `${y - 20}px`;

        const scale = Math.random() * 0.7 + 0.6;
        const rotation = Math.random() * 360;
        const brightness = Math.random() * 0.5 + 0.6;

        rose.style.transform = `translate(-50%, -50%) scale(${scale}) rotate(${rotation}deg)`;
        rose.style.filter = `drop-shadow(2px 4px 4px rgba(0,0,0,0.6)) brightness(${brightness})`;
        rose.style.zIndex = Math.floor((scaleFactor - r) * 10);

        heartContainer.appendChild(rose);
      }

      // Kalbi görünür yap
      document.getElementById('heart-wrapper').style.opacity = '1';
    }

    function startSequence() {
      startHeartsShow();

      // 5. Saniyede mesaj kaybolur
      setTimeout(() => {
        const msg = document.getElementById('romanticMsg');
        msg.style.opacity = '0';
        setTimeout(() => msg.remove(), 1500);
      }, 5000);

      // 6.2. Saniyede tek fide büyümeye başlar
      setTimeout(() => {
        const container = document.createElement('div');
        container.className = 'single-plant-container';
        container.id = 'singleRoseContainer';

        const plantEl = document.createElement('div');
        plantEl.className = 'plant-stage';

        const stages = ['🌱', '🌿', '🌷', '🌹'];
        plantEl.innerHTML = stages[0];
        
        setTimeout(() => { plantEl.innerHTML = stages[1]; }, 900);
        setTimeout(() => { plantEl.innerHTML = stages[2]; }, 1800);
        setTimeout(() => { 
          plantEl.innerHTML = stages[3];
          plantEl.style.transform = 'scale(1.2)';
          setTimeout(() => plantEl.style.transform = 'scale(1)', 300);
        }, 2700);

        container.appendChild(plantEl);
        document.body.appendChild(container);

        // 10.5. Saniyede tek gül kaybolur, yerine dev atan kalp gelir
        setTimeout(() => {
          container.style.opacity = '0';
          container.style.transform = 'translate(-50%, -50%) scale(0)';
          setTimeout(() => container.remove(), 1500);
          
          // Dev kalbi oluştur ve ekranda belirmesini sağla
          createGiantHeart();
        }, 4500); // Fide belirdikten 4.5 sn sonra (Toplamda ~10.7 sn)

      }, 6200);
    }

    window.onload = () => {
      setTimeout(startSequence, 1000);
    };
  </script>

</body>
</html>
